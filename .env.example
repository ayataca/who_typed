# Scrapboxの議事録に記載の6つの値をコピペしてください。

# 展示用Xアカウントのユーザー名（@付きでも無しでも可）
X_HANDLE=

# アプリの「Consumer Keys」（API Key と API Key Secret）
X_API_KEY=
X_API_SECRET=

# 展示用アカウントの「Access Token and Secret」
# ※ アプリの権限を「Read and write」にしてから発行したものを使うこと
X_ACCESS_TOKEN=
X_ACCESS_TOKEN_SECRET=

# 1 の間は実際には投稿しない（模擬投稿）。本番で投稿するときだけ 0 にする
DRY_RUN=1

# 本番のとき、感想タイムラインとフィードは X のアカウントの実際のポストから作る
# 新しいポストを何秒ごとに読むか（新しい分だけ）／消されたものを外すため、何分ごとに読み直すか／読み直す件数（0 で読まない）
X_POLL_SEC=30
X_VERIFY_MIN=10
X_FETCH_MAX=100

# 展示用フィード（/feed）に出す表示名と自己紹介（省略可。表示名を省くとユーザー名を使う）
X_DISPLAY_NAME=
X_BIO=

# サーバーのポート番号（通常は変更不要）
PORT=8787

# 声の対話（keycap_lab の「dialogue」）の LLM。空でも動く（返事は台本の文言で進む）
ANTHROPIC_API_KEY=
# LLM_MODEL=claude-haiku-5-5
